+"#;
+const ISSUER: &str = "https://realm.example/oauth2/mail";
+
+fn provider(userinfo: String) -> OpenIdDirectory {
+    let mut keys = AHashMap::new();
+    keys.insert("fixture".into(), Arc::new(CachedKey {
+        decoding_key: DecodingKey::from_rsa_pem(PUBLIC_KEY).unwrap(),
+        algorithm: Algorithm::RS256,
+    }));
+    OpenIdDirectory {
+        config: OidcConfig {
+            issue_url: ISSUER.into(), require_aud: Some("mail".into()),
+            require_scopes: vec!["openid".into()], claim_email: "email".into(),
+            claim_name: None, claim_groups: None, default_domain: None,
+        },
+        discovery: OidcDiscovery { url: ISSUER.into(), document: DiscoveryDocument {
+            issuer: ISSUER.into(), jwks_uri: "http://127.0.0.1:1/unreachable".into(),
+            userinfo_endpoint: userinfo, token_endpoint: String::new(), authorization_endpoint: String::new(),
+            end_session_endpoint: None, scopes_supported: None, claims_supported: None,
+            code_challenge_methods_supported: None,
+        }},
+        http: utils::http::http_client_builder(false).build().unwrap(),
+        cache: RwLock::new(JwksCache { keys, last_updated: Instant::now() }),
+    }
+}
+
+fn token(issuer: &str, audience: &str) -> String {
+    let mut header = Header::new(Algorithm::RS256);
+    header.kid = Some("fixture".into());
+    encode(&header, &json!({"iss":issuer,"aud":audience,"sub":"person-uuid", "scope":"openid",
+        "exp": std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs()+300}),
+        &EncodingKey::from_rsa_pem(PRIVATE_KEY).unwrap()).unwrap()
+}
+
+#[tokio::test]
+async fn issuer_only_jwt_uses_validated_userinfo_identity() {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = format!("http://{}/userinfo", listener.local_addr().unwrap());
+    let server = std::thread::spawn(move || {
+        let (mut stream, _) = listener.accept().unwrap();
+        stream.set_read_timeout(Some(std::time::Duration::from_secs(5))).unwrap();
+        let mut buffer = [0;8192]; let count=stream.read(&mut buffer).unwrap();
+        assert!(std::str::from_utf8(&buffer[..count]).unwrap().to_ascii_lowercase().contains("authorization: bearer "));
+        let body=r#"{"sub":"person-uuid","email":"person@realm.example"}"#;
+        write!(stream,"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",body.len(),body).unwrap();
+    });
+    let account=provider(url).authenticate(&crate::Credentials::Bearer {username:None, token:token(ISSUER,"mail")}).await.unwrap();
+    assert_eq!(account.email,"person@realm.example");
+    server.join().unwrap();
+}
+
+#[tokio::test]
+async fn invalid_signature_audience_or_issuer_cannot_reach_userinfo() {
+    let provider=provider("http://127.0.0.1:1/must-not-fetch".into());
+    let valid=token(ISSUER,"mail");
+    let (claims,signature)=valid.rsplit_once('.').unwrap();
+    let changed=if signature.starts_with('A') {'B'} else {'A'};
+    let invalid=format!("{claims}.{changed}{}",&signature[1..]);
+    for token in [invalid,token(ISSUER,"wrong-audience"),token("https://other.example/","mail")] {
+        let error=provider.authenticate(&crate::Credentials::Bearer {username:None,token}).await.unwrap_err();
+        assert!(error.to_string().contains("JWT validation failed"),"{error}");
+    }
+}
