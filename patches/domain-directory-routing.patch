diff --git a/crates/common/src/auth/domain_directory.rs b/crates/common/src/auth/domain_directory.rs
new file mode 100644
index 0000000..fe0cca3
--- /dev/null
+++ b/crates/common/src/auth/domain_directory.rs
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+#![forbid(unsafe_code)]
+
+use std::borrow::Cow;
+
+pub(crate) fn normalize_domain(domain: &str) -> Option<Cow<'_, str>> {
+    let domain = domain.trim_matches(|character: char| character.is_ascii_whitespace());
+    let domain = domain.strip_suffix('.').unwrap_or(domain);
+
+    if domain.is_empty() {
+        None
+    } else if domain
+        .bytes()
+        .any(|character| character.is_ascii_uppercase())
+    {
+        Some(Cow::Owned(domain.to_ascii_lowercase()))
+    } else {
+        Some(Cow::Borrowed(domain))
+    }
+}
+
+pub(crate) fn select_configured_or_default<D, F>(
+    configured_id: Option<u32>,
+    default: Option<D>,
+    lookup: F,
+) -> Option<D>
+where
+    F: FnOnce(u32) -> Option<D>,
+{
+    configured_id.and_then(lookup).or(default)
+}
+
+/// An issuer is an untrusted hint, never an authentication result. Only
+/// already-configured providers can be selected; duplicates fail closed.
+pub(crate) fn select_unique_issuer<'a, D>(
+    issuer: &str,
+    configured: impl IntoIterator<Item = (&'a str, D)>,
+) -> Result<Option<D>, ()> {
+    let mut matches = configured.into_iter().filter(|(known, _)| *known == issuer);
+    let selected = matches.next().map(|(_, directory)| directory);
+    if matches.next().is_some() { Err(()) } else { Ok(selected) }
+}
+
+pub(crate) fn identity_directory_matches<D>(
+    configured: Option<&std::sync::Arc<D>>,
+    selected: &std::sync::Arc<D>,
+) -> bool {
+    configured.is_some_and(|configured| std::sync::Arc::ptr_eq(configured, selected))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{normalize_domain, select_configured_or_default, select_unique_issuer, identity_directory_matches};
+    use std::cell::Cell;
+
+    #[test]
+    fn normalizes_domain_lookup_key() {
+        assert_eq!(
+            normalize_domain("\t ExAmPlE.CoM. \r\n").as_deref(),
+            Some("example.com")
+        );
+    }
+
+    #[test]
+    fn removes_exactly_one_dns_root_dot() {
+        assert_eq!(
+            normalize_domain("example.com..").as_deref(),
+            Some("example.com.")
+        );
+    }
+
+    #[test]
+    fn empty_normalized_domain_skips_lookup() {
+        assert_eq!(normalize_domain(" \t.\r\n"), None);
+    }
+
+    #[test]
+    fn configured_directory_overrides_default() {
+        assert_eq!(
+            select_configured_or_default(Some(7), Some("default"), |id| {
+                assert_eq!(id, 7);
+                Some("configured")
+            }),
+            Some("configured")
+        );
+    }
+
+    #[test]
+    fn absent_or_unusable_configuration_falls_back_to_default() {
+        assert_eq!(
+            select_configured_or_default(None, Some("default"), |_| Some("unexpected")),
+            Some("default")
+        );
+        assert_eq!(
+            select_configured_or_default(Some(8), Some("default"), |_| None),
+            Some("default")
+        );
+    }
+
+    #[test]
+    fn absent_configuration_does_not_call_lookup() {
+        let called = Cell::new(false);
+        let selected = select_configured_or_default(None, Some(9), |_| {
+            called.set(true);
+            Some(10)
+        });
+
+        assert_eq!(selected, Some(9));
+        assert!(!called.get());
+    }
+
+    #[test]
+    fn no_usable_directory_returns_none_without_default() {
+        assert_eq!(
+            select_configured_or_default::<u8, _>(Some(8), None, |_| None),
+            None
+        );
+    }
+    #[test]
+    fn issuer_only_hint_selects_exact_configured_realm() {
+        let providers = [("https://id.a/oauth2/mail", 1), ("https://id.b/oauth2/mail", 2)];
+        assert_eq!(select_unique_issuer("https://id.b/oauth2/mail", providers), Ok(Some(2)));
+    }
+
+    #[test]
+    fn unknown_or_similar_issuer_cannot_select_a_provider() {
+        for issuer in ["https://id.a/oauth2/mail/", "https://ID.A/oauth2/mail", "https://attacker.invalid/", "https://id.a/oauth2/mail?x=1"] {
+            assert_eq!(select_unique_issuer(issuer, [("https://id.a/oauth2/mail", 1)]), Ok(None));
+        }
+    }
+
+    #[test]
+    fn ambiguous_configured_issuer_fails_closed() {
+        assert_eq!(select_unique_issuer("https://id.a/", [("https://id.a/", 1), ("https://id.a/", 2)]), Err(()));
+    }
+
+    #[test]
+    fn authenticated_identity_accepts_same_provider_and_domain_alias() {
+        let provider=std::sync::Arc::new("provider");
+        let alias=provider.clone();
+        assert!(identity_directory_matches(Some(&provider), &provider));
+        assert!(identity_directory_matches(Some(&alias), &provider));
+    }
+
+    #[test]
+    fn conflicting_email_or_userinfo_tenant_is_rejected() {
+        let provider=std::sync::Arc::new("provider");
+        let other=std::sync::Arc::new("provider");
+        assert!(!identity_directory_matches(Some(&other), &provider));
+    }
+
+    #[test]
+    fn unmapped_identity_domain_cannot_use_default_provider() {
+        let provider=std::sync::Arc::new("default provider");
+        assert!(!identity_directory_matches(None, &provider));
+    }
+
+}
